        <!-- ===== TRANSITION LANE ===== -->
        <mxCell id="note_becomes" value="Applicant&#xa;&quot;becomes&quot;&#xa;Student" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#D6B656;strokeWidth=1;fontSize=10;fontStyle=2;align=center;" vertex="1" parent="lane_note">
          <mxGeometry x="900" y="825" width="80" height="60" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->
