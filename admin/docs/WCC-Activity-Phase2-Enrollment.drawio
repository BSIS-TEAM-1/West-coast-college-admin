          <mxGeometry x="0" y="40" width="2360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="lane_sys" value="SYSTEM" style="shape=swimlane;startSize=80;horizontal=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=13;fontStyle=1;swimlaneFillColor=#F5F5F5;" vertex="1" parent="pool">
          <mxGeometry x="0" y="280" width="2360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="lane_stu" value="STUDENT" style="shape=swimlane;startSize=80;horizontal=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=13;fontStyle=1;swimlaneFillColor=#F8CECC;" vertex="1" parent="pool">
          <mxGeometry x="0" y="520" width="2360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="lane_note" value="TRANSITION" style="shape=swimlane;startSize=80;horizontal=1;fillColor=#FFFFCC;strokeColor=#D6B656;strokeWidth=2;fontSize=13;fontStyle=1;swimlaneFillColor=#FFFFCC;" vertex="1" parent="pool">
          <mxGeometry x="0" y="760" width="2360" height="240" as="geometry" />
        </mxCell>

        <!-- ===== REGISTRAR LANE ===== -->
        <mxCell id="r_enroll" value="Enroll Student" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="lane_reg">
          <mxGeometry x="100" y="105" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- ===== SYSTEM LANE ===== -->
        <mxCell id="s_createstu" value="Create Student Record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_sys">
          <mxGeometry x="280" y="345" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s_createenr" value="Create Enrollment Record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_sys">
          <mxGeometry x="460" y="345" width="140" height="40" as="geometry" />
