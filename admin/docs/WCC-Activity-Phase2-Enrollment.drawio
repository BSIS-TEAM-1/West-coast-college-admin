        <mxCell id="e4" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="s_assignblk" target="s_emailenr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- Transition note -->
        <mxCell id="e5" style="html=1;strokeWidth=1;strokeColor:#D6B656;endArrow=classic;dashed=1;" edge="1" parent="1" source="s_emailenr" target="note_becomes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- Student: Log In -> View Dashboard -->
        <mxCell id="e6" style="html=1;strokeWidth=1;strokeColor:#D6B656;endArrow=classic;dashed=1;" edge="1" parent="1" source="note_becomes" target="st_login"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="st_login" target="st_dash"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Note: Continue to Phase 3 -->
        <mxCell id="note_phase3" value="→ Continue to Phase 3: Grading" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#D6B656;strokeWidth=1;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1">
