        <mxCell id="e1" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="r_enroll" target="s_createstu"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- System: Create Student -> Create Enrollment -> Assign Block -> Send Email -->
        <mxCell id="e2" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="s_createstu" target="s_createenr"><mxGeometry relative="1" as="geometry" /></mxCell>
