        <mxCell id="s_emailenr" value="Send Enrollment Email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_sys">
          <mxGeometry x="820" y="345" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- ===== STUDENT LANE ===== -->
        <mxCell id="st_login" value="Log In" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_stu">
          <mxGeometry x="1000" y="585" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st_dash" value="View Student Dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_stu">
          <mxGeometry x="1180" y="585" width="140" height="40" as="geometry" />
