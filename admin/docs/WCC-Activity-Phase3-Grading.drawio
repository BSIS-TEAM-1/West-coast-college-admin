        <!-- ===== HORIZONTAL LANES (top to bottom) ===== -->
        <mxCell id="lane_prof" value="PROFESSOR" style="shape=swimlane;startSize=80;horizontal=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=13;fontStyle=1;swimlaneFillColor=#E1D5E7;" vertex="1" parent="pool">
          <mxGeometry x="0" y="40" width="2760" height="300" as="geometry" />
