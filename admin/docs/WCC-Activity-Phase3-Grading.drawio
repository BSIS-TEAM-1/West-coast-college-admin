        <mxCell id="lane_sys" value="SYSTEM" style="shape=swimlane;startSize=80;horizontal=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=13;fontStyle=1;swimlaneFillColor=#F5F5F5;" vertex="1" parent="pool">
          <mxGeometry x="0" y="340" width="2760" height="300" as="geometry" />
        </mxCell>
        <mxCell id="lane_reg" value="REGISTRAR" style="shape=swimlane;startSize=80;horizontal=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;fontStyle=1;swimlaneFillColor=#D5E8D4;" vertex="1" parent="pool">
          <mxGeometry x="0" y="640" width="2760" height="300" as="geometry" />
