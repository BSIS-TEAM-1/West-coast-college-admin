  <diagram name="WCC Activity Diagram - Phase 4: COR & Announcements" id="wcc-activity-phase4">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1600" math="0" shadow="0">
