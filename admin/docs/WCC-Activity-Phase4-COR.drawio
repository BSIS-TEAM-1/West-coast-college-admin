        <!-- ===== PROFESSOR LANE ===== -->
        <mxCell id="p_reqchange" value="Request Grade Change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_prof">
          <mxGeometry x="300" y="105" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p_notified" value="Notified of Denial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_prof">
          <mxGeometry x="1100" y="105" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- ===== SYSTEM LANE ===== -->
        <mxCell id="s_notifyreg" value="Notify Registrar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_sys">
          <mxGeometry x="500" y="385" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s_updategrade" value="Update Grade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_sys">
          <mxGeometry x="900" y="385" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s_recalc" value="Recalculate GWA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_sys">
          <mxGeometry x="1080" y="385" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s_compile" value="Compile Enrollment Data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_sys">
          <mxGeometry x="1500" y="385" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s_genpdf" value="Generate PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_sys">
          <mxGeometry x="1680" y="385" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s_storedoc" value="Store Document" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_sys">
          <mxGeometry x="1860" y="385" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s_broadcast" value="Broadcast to Students" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_sys">
          <mxGeometry x="2300" y="385" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- ===== REGISTRAR LANE ===== -->
        <mxCell id="r_reviewchg" value="Review Change Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_reg">
          <mxGeometry x="680" y="665" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_approvechg" value="Approve Change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_reg">
          <mxGeometry x="880" y="665" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_deny" value="Deny Change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_reg">
          <mxGeometry x="1080" y="665" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_gencor" value="Generate COR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="lane_reg">
          <mxGeometry x="1350" y="665" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_postann" value="Post Announcement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_reg">
          <mxGeometry x="2150" y="665" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- ===== STUDENT LANE ===== -->
        <mxCell id="st_viewupdated" value="View Updated Grades" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_stu">
          <mxGeometry x="1250" y="945" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st_dlcor" value="Download COR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_stu">
          <mxGeometry x="1900" y="945" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st_readann" value="Read Announcements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;" vertex="1" parent="lane_stu">
          <mxGeometry x="2350" y="945" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="end" value="END" style="ellipse;fillColor=#000000;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="lane_stu">
          <mxGeometry x="2520" y="950" width="60" height="30" as="geometry" />
        </mxCell>

        <!-- ===== DECISION POINTS ===== -->
        <mxCell id="d_change" value="Grade Change Needed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="170" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d_approvechg" value="Approve Change?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="730" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->
        <!-- Grade Change? Yes -> Request -> Notify Registrar -> Review Change Request -> Approve Change? -->
        <mxCell id="e1" value="Yes" style="html=1;strokeWidth=2;strokeColor:#009900;endArrow=classic;fontSize=11;fontStyle=1;" edge="1" parent="1" source="d_change" target="p_reqchange"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="p_reqchange" target="s_notifyreg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="s_notifyreg" target="r_reviewchg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="r_reviewchg" target="d_approvechg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- Approve Change? Yes -> Approve Change -> Update Grade -> Recalculate GWA -> View Updated Grades -->
        <mxCell id="e5" value="Yes" style="html=1;strokeWidth=2;strokeColor:#009900;endArrow=classic;fontSize=11;fontStyle=1;" edge="1" parent="1" source="d_approvechg" target="r_approvechg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="r_approvechg" target="s_updategrade"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="s_updategrade" target="s_recalc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="s_recalc" target="st_viewupdated"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- Approve Change? No -> Deny Change -> Notified of Denial -->
        <mxCell id="e9" value="No" style="html=1;strokeWidth=2;strokeColor=#CC0000;endArrow=classic;fontSize=11;fontStyle=1;" edge="1" parent="1" source="d_approvechg" target="r_deny"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="r_deny" target="p_notified"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- Grade Change? No -> Generate COR -->
        <mxCell id="e11" value="No" style="html=1;strokeWidth=2;strokeColor:#CC0000;endArrow=classic;fontSize=11;fontStyle=1;" edge="1" parent="1" source="d_change" target="r_gencor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- View Updated Grades -> Generate COR -->
        <mxCell id="e12" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="st_viewupdated" target="r_gencor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- Notified of Denial -> Generate COR -->
        <mxCell id="e13" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="p_notified" target="r_gencor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- COR flow: Generate COR -> Compile -> Generate PDF -> Store -> Download COR -->
        <mxCell id="e14" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="r_gencor" target="s_compile"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="s_compile" target="s_genpdf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="s_genpdf" target="s_storedoc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="s_storedoc" target="st_dlcor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- Announcements: Post -> Broadcast -> Read -> END -->
        <mxCell id="e18" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="st_dlcor" target="r_postann"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="r_postann" target="s_broadcast"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e20" style="html=1;strokeWidth=2;strokeColor:#333333;endArrow=classic;" edge="1" parent="1" source="s_broadcast" target="st_readann"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e21" style="html=1;strokeWidth=2;strokeColor=#333333;endArrow=classic;" edge="1" parent="1" source="st_readann" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
