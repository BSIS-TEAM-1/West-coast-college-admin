services:
  - type: web
    name: wcc-admin-backend
    env: node
    repo: https://github.com/rence141/west-coast-college-admin
    rootDir: admin
    buildCommand: npm install && npm run build
    startCommand: npm start
    # Backup archives used to be written inside the container filesystem and
    # were erased by every restart/redeploy. Mount a disk and point the backup
    # store at it so archives survive deploys.
    disk:
      name: wcc-backups
      mountPath: /var/backups
      sizeGB: 1
    envVars:
      - key: NODE_ENV
        value: production
      - key: BACKUP_STORAGE_PATH
        value: /var/backups
      - key: BACKUP_AUTO_RETENTION
        value: "true"
      # Keep 7 daily restore points plus 4 weekly ones (~12 archives).
      - key: BACKUP_RETENTION_HOURLY
        value: "0"
      - key: BACKUP_RETENTION_DAILY
        value: "7"
      - key: BACKUP_RETENTION_WEEKLY
        value: "4"
      - key: BACKUP_RETENTION_MONTHLY
        value: "0"
      # Roots this service wrote to before the disk was mounted, so records
      # created earlier still count as belonging to this server.
      - key: BACKUP_LEGACY_STORAGE_PATHS
        value: /app/server/backups,/opt/render/project/src/admin/server/backups
      - key: MONGODB_URI
        value: YOUR_MONGODB_URI_HERE
      - key: JWT_SECRET
        value: YOUR_JWT_SECRET_HERE
      - key: VERIFICATION_EMAIL_PROVIDER_PRIORITY
        value: gmail-api
      - key: GMAIL_CLIENT_ID
        value: YOUR_GMAIL_CLIENT_ID_HERE
      - key: GMAIL_CLIENT_SECRET
        value: YOUR_GMAIL_CLIENT_SECRET_HERE
      - key: GMAIL_REFRESH_TOKEN
        value: YOUR_GMAIL_REFRESH_TOKEN_HERE
      - key: GMAIL_SENDER_EMAIL
        value: YOUR_GMAIL_SENDER_EMAIL_HERE
